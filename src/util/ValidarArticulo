export function validarArticulo(articulo) {
    const { nombre, marca, url, categoria, stock, precio } = articulo

    return {
        nombre: nombre.length > 0 && nombre.length <= 150,
        marca: marca.length > 0 && marca.length <= 50,
        url: (() => {
            if (url.length === 0) return false

            try {
                const parsedUrl = new URL(url)
                return parsedUrl.protocol === 'http:' || parsedUrl.protocol === 'https:'
            } catch {
                return false
            }
        })(),
        categoria: categoria !== '',
        // Validar que el stock sea un numero mayor o igual a 0
        stock: (() => {
            if (
                (typeof stock !== 'string' && typeof stock !== 'number') ||
                (typeof stock === 'string' && stock.trim() === '')
            ) {
                return false;
            }

            const num = Number(stock);
            return Number.isInteger(num) && num >= 0;
        })(),
        // Validar que el precio sea un numero mayor a 0
        precio: (() => {
            if (
                (typeof precio !== 'string' && typeof precio !== 'number') ||
                (typeof precio === 'string' && precio.trim() === '')
            ) {
                return false;
            }

            const num = Number(precio);
            return Number.isInteger(num) && num > 0;
        })()
    }
}